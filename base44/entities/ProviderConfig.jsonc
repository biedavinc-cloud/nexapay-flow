{
  "name": "ProviderConfig",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "KUCOIN",
        "BINANCE",
        "BINGX",
        "COINBASE",
        "WEB3_DIRECT"
      ],
      "description": "Exchange identifier"
    },
    "label": {
      "type": "string",
      "description": "Display name"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPERATIONAL",
        "DEGRADED",
        "DOWN",
        "DISABLED"
      ],
      "default": "OPERATIONAL",
      "description": "Operational health"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Withdrawals enabled for this exchange"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Preferred exchange"
    },
    "api_key_label": {
      "type": "string",
      "description": "Reference label for the configured API key"
    },
    "has_api_secret": {
      "type": "boolean",
      "default": false,
      "description": "Whether the API secret is stored in Secrets"
    },
    "has_passphrase": {
      "type": "boolean",
      "default": false,
      "description": "Whether the passphrase is stored (KuCoin)"
    },
    "withdrawals_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Withdrawal permission active"
    },
    "success_rate": {
      "type": "number",
      "default": 0,
      "description": "Observed success rate percentage"
    },
    "last_checked": {
      "type": "string",
      "format": "date-time",
      "description": "Last health check timestamp"
    },
    "notes": {
      "type": "string",
      "description": "Free-form notes"
    }
  },
  "required": [
    "provider",
    "label",
    "status",
    "enabled"
  ]
}