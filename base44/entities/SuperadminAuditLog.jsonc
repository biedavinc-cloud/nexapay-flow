      "type": "string",
      "description": "Admin email (snapshot)"
    },
    "action": {
      "type": "string",
      "description": "Action performed"
    },
    "target_tenant_id": {
      "type": "string",
      "description": "Affected tenant"
    },
    "details": {
      "type": "string",
      "description": "JSON details"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
