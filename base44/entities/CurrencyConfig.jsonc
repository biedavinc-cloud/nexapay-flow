{
  "name": "CurrencyConfig",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Fiat ISO code (EUR, USD, XOF, XAF...)"
    },
    "label": {
      "type": "string",
      "description": "Display name"
    },
    "symbol": {
      "type": "string",
      "description": "Currency symbol"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this fiat currency is accepted at checkout"
    },
    "auto_convert": {
      "type": "boolean",
      "default": true,
      "description": "Auto-convert captured fiat into USDT"
    },
    "min_threshold": {
      "type": "number",
      "default": 0,
      "description": "Minimum fiat amount triggering automatic conversion"
    },
    "margin_pct": {
      "type": "number",
      "default": 0,
      "description": "Conversion margin applied on top of the live rate (%)"
    }
  },
  "required": [
    "code",
    "label",
    "enabled"
  ]
}