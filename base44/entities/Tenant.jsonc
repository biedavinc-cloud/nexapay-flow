{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Merchant company / entity name"
    },
    "country": {
      "type": "string",
      "description": "Merchant country (ISO code)"
    },
    "city": {
      "type": "string",
      "description": "Merchant city"
    },
    "business_activity": {
      "type": "string",
      "description": "Business sector / activity"
    },
    "tier": {
      "type": "string",
      "enum": [
        "BASIC",
        "ADVANCED",
        "PRO"
      ],
      "default": "BASIC",
      "description": "Subscription tier"
    },
    "has_paid_access": {
      "type": "boolean",
      "default": false,
      "description": "Production access unlocked (one-time pass paid)"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "PENDING_ONBOARDING",
        "AWAITING_APPROVAL",
        "APPROVED",
        "SUSPENDED",
        "REJECTED"
      ],
      "default": "PENDING_ONBOARDING",
      "description": "Tenant approval lifecycle"
    },
    "daily_limit": {
      "type": "number",
      "default": 200,
      "description": "Max fiat volume per day (9999999 = unlimited)"
    },
    "commission_rate": {
      "type": "number",
      "default": 3.5,
      "description": "Platform commission percentage applied at source"
    },
    "checkout_primary_color": {
      "type": "string",
      "default": "#6366F1",
      "description": "Merchant checkout widget primary color"
    },
    "logo_url": {
      "type": "string",
      "description": "Merchant logo shown on the checkout header"
    },
    "kyc_status": {
      "type": "string",
      "enum": [
        "PENDING_PAYMENT",
        "PENDING_KYC",
        "APPROVED",
        "REJECTED"
      ],
      "default": "PENDING_PAYMENT",
      "description": "Institutional KYC state"
    },
    "kyc_doc_url": {
      "type": "string",
      "description": "Uploaded ID document (CNI/passport) file url"
    },
    "selfie_url": {
      "type": "string",
      "description": "Liveness selfie file url"
    },
    "id_name": {
      "type": "string",
      "description": "Legal name on the KYC document (name-matching)"
    },
    "id_number": {
      "type": "string",
      "description": "ID document number"
    },
    "phone": {
      "type": "string",
      "description": "Merchant contact phone"
    },
    "receiving_wallet": {
      "type": "string",
      "description": "Merchant USDT receiving wallet address"
    },
    "blockchain": {
      "type": "string",
      "enum": [
        "POLYGON",
        "TRC20"
      ],
      "default": "POLYGON",
      "description": "Settlement chain for merchant payouts"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false,
      "description": "All onboarding steps completed"
    }
  },
  "required": [
    "company_name",
    "tier"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    }
  }
}