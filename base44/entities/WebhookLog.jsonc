{
  "name": "WebhookLog",
  "type": "object",
  "properties": {
    "endpoint_url": {
      "type": "string",
      "description": "URL the webhook was sent to"
    },
    "event": {
      "type": "string",
      "description": "Event type (e.g. payment.succeeded)"
    },
    "order_id": {
      "type": "string",
      "description": "Related order id"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED",
        "RETRYING"
      ],
      "default": "SUCCESS",
      "description": "Delivery status"
    },
    "http_status": {
      "type": "number",
      "description": "HTTP status code returned by the endpoint"
    },
    "attempts": {
      "type": "number",
      "default": 1,
      "description": "Number of delivery attempts"
    },
    "response_snippet": {
      "type": "string",
      "description": "Truncated response body"
    }
  },
  "required": [
    "endpoint_url",
    "event",
    "status"
  ]
}