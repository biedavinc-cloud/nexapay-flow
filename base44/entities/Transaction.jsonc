{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Merchant tenant id (multi-tenant isolation)"
    },
    "reference_fiat": {
      "type": "string",
      "description": "Unique payment reference"
    },
    "client_name": {
      "type": "string",
      "description": "Payer display name"
    },
    "amount_fiat": {
      "type": "number",
      "description": "Order amount (crypto units when DIRECT_CRYPTO)"
    },
    "currency_fiat": {
      "type": "string",
      "default": "USDT",
      "description": "Asset code for direct crypto orders"
    },
    "gateway_fee": {
      "type": "number",
      "default": 0,
      "description": "Fiat gateway fee"
    },
    "nexapay_commission": {
      "type": "number",
      "default": 0,
      "description": "Platform commission (USDT) deducted at source"
    },
    "asset": {
      "type": "string",
      "default": "USDT",
      "description": "Crypto asset purchased (USDT, BTC, ETH)"
    },
    "network": {
      "type": "string",
      "enum": [
        "TRC20",
        "ERC20",
        "POLYGON"
      ],
      "default": "TRC20",
      "description": "Settlement network"
    },
    "usdt_amount": {
      "type": "number",
      "description": "Gross USDT before commission"
    },
    "usdt_net_sent": {
      "type": "number",
      "description": "Net USDT sent to the merchant wallet"
    },
    "exchange_rate": {
      "type": "number",
      "description": "Rate used at quote time"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "CARD",
        "MOBILE_MONEY",
        "BANK_TRANSFER",
        "DIRECT_CRYPTO"
      ],
      "default": "DIRECT_CRYPTO",
      "description": "How the order was initiated"
    },
    "crypto_provider": {
      "type": "string",
      "enum": [
        "KUCOIN",
        "BINANCE",
        "BINGX",
        "COINBASE",
        "WEB3_DIRECT"
      ],
      "description": "Exchange that executed the order"
    },
    "destination_wallet": {
      "type": "string",
      "description": "Destination wallet address"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "FIAT_APPROVED",
        "PROCESSING_CRYPTO",
        "COMPLETED",
        "FAILED"
      ],
      "default": "PENDING",
      "description": "Current execution state"
    },
    "payload_base64": {
      "type": "string",
      "description": "Raw provider payload (base64)"
    },
    "tx_hash_crypto": {
      "type": "string",
      "description": "On-chain/withdrawal tx hash once completed"
    },
    "error_message": {
      "type": "string",
      "description": "Failure reason if FAILED"
    }
  },
  "required": [
    "reference_fiat",
    "amount_fiat",
    "usdt_amount",
    "exchange_rate",
    "payment_method",
    "crypto_provider",
    "destination_wallet",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}