{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Merchant tenant id (multi-tenant isolation)"
    },
    "reference_fiat": {
      "type": "string",
      "description": "Unique payment reference"
    },
    "client_name": {
      "type": "string",
      "description": "Payer display name"
    },
    "amount_fiat": {
      "type": "number",
      "description": "Order amount (crypto units when DIRECT_CRYPTO)"
    },
    "currency_fiat": {
      "type": "string",
      "default": "USDT",
      "description": "Asset code for direct crypto orders"
    },
    "fee_amount_fiat": {
      "type": "number",
      "default": 0,
      "description": "NexaPay fiat commission charged on the order"
    },
    "net_fiat_amount": {
      "type": "number",
      "default": 0,
      "description": "Fiat amount after NexaPay commission (converted to USDT)"
    },
    "gateway_fee": {
      "type": "number",
      "default": 0,
      "description": "Fiat gateway fee"
    },
    "nexapay_commission": {
      "type": "number",
      "default": 0,
      "description": "Platform commission (USDT) deducted at source"
    },
    "asset": {
      "type": "string",
      "default": "USDT",
      "description": "Crypto asset purchased (USDT, BTC, ETH)"
    },
    "network": {
      "type": "string",
      "enum": [
        "TRC20",
        "ERC20",
        "POLYGON"
      ],
      "default": "TRC20",
      "description": "Settlement network"
    },
    "usdt_amount": {
      "type": "number",
      "description": "Gross USDT before commission"
    },
    "usdt_amount_estimated": {
      "type": "number",
      "description": "USDT estimate shown to the client at quote time (net of commission)"
    },
    "usdt_net_sent": {
      "type": "number",
      "description": "Net USDT sent to the merchant wallet"
    },
    "exchange_rate": {
      "type": "number",
      "description": "Rate used at quote time"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "CARD",
        "MOBILE_MONEY",
        "BANK_TRANSFER",
        "DIRECT_CRYPTO"
      ],
      "default": "DIRECT_CRYPTO",
      "description": "How the order was initiated"
    },
    "psp_provider": {
      "type": "string",
      "enum": [
        "KORAPAY",
        "PAYUNIT"
      ],
      "description": "Which PSP captured the fiat (white-labeled under NexaPay)"
    },
    "korapay_reference": {
      "type": "string",
      "description": "Korapay transaction/payment reference (KPY-...)"
    },
    "crypto_provider": {
      "type": "string",
      "enum": [
        "KUCOIN",
        "BINANCE",
        "BINGX",
        "COINBASE",
        "WEB3_DIRECT"
      ],
      "description": "Exchange that executed the order (empty until real execution)"
    },
    "destination_wallet": {
      "type": "string",
      "description": "Destination wallet address"
    },
    "status": {
      "type": "string",
      "enum": [
        "INITIATED",
        "FIAT_RECEIVED",
        "CRYPTO_PROCESSING",
        "COMPLETED",
        "CRYPTO_FAILED",
        "REFUNDED",
        "PENDING",
        "FIAT_APPROVED",
        "PROCESSING_CRYPTO",
        "FAILED"
      ],
      "default": "INITIATED",
      "description": "Current execution state"
    },
    "payload_base64": {
      "type": "string",
      "description": "Raw provider payload (base64)"
    },
    "tx_hash_crypto": {
      "type": "string",
      "description": "On-chain/withdrawal tx hash once completed"
    },
    "error_message": {
      "type": "string",
      "description": "Failure reason if FAILED / CRYPTO_FAILED"
    }
  },
  "required": [
    "reference_fiat",
    "amount_fiat",
    "usdt_amount",
    "exchange_rate",
    "payment_method",
    "destination_wallet",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    }
  }
}