{
  "name": "WebhookEndpoint",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Endpoint label"
    },
    "url": {
      "type": "string",
      "description": "Target URL receiving webhook events"
    },
    "signing_secret": {
      "type": "string",
      "description": "Secret used to sign outgoing webhooks (whsec_)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether events are delivered to this endpoint"
    },
    "events": {
      "type": "string",
      "default": "payment.succeeded,payment.failed",
      "description": "Comma-separated subscribed events"
    }
  },
  "required": [
    "label",
    "url",
    "signing_secret",
    "active"
  ]
}