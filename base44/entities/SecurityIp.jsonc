{
  "name": "SecurityIp",
  "type": "object",
  "properties": {
    "ip": {
      "type": "string",
      "description": "Allowed IP address or CIDR"
    },
    "label": {
      "type": "string",
      "description": "Label for the allowed IP"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the IP is currently allowed"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiry timestamp"
    }
  },
  "required": [
    "ip",
    "label",
    "active"
  ]
}