{
  "name": "ApiKey",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Key pair label"
    },
    "secret_key": {
      "type": "string",
      "description": "Secret key (sk_) used server-side by the marketplace"
    },
    "publishable_key": {
      "type": "string",
      "description": "Publishable key (pk_) used client-side"
    },
    "tenant_id": {
      "type": "string",
      "description": "Merchant tenant this key belongs to"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the key pair is active"
    },
    "last_used": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the key was used"
    }
  },
  "required": [
    "label",
    "secret_key",
    "publishable_key",
    "active"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    }
  }
}