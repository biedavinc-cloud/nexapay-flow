{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "SUPER_ADMIN",
        "TENANT_USER"
      ],
      "default": "user",
      "description": "Platform role. SUPER_ADMIN bypasses merchant onboarding and has unrestricted platform access."
    },
    "tenant_id": {
      "type": "string",
      "description": "Linked merchant tenant id"
    },
    "kyc_status": {
      "type": "string",
      "default": "PENDING_PAYMENT",
      "description": "Merchant KYC state"
    }
  },
  "required": []
}