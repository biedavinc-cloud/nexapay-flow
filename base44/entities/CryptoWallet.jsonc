{
  "name": "CryptoWallet",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Wallet label"
    },
    "address": {
      "type": "string",
      "description": "Destination wallet address"
    },
    "chain": {
      "type": "string",
      "enum": [
        "TRC20",
        "ERC20",
        "BEP20",
        "POLYGON"
      ],
      "default": "TRC20",
      "description": "Settlement network"
    },
    "currency": {
      "type": "string",
      "default": "USDT",
      "description": "Settlement currency"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Default deposit wallet"
    }
  },
  "required": [
    "label",
    "address",
    "chain"
  ]
}